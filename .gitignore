# Monorepo 공통 .gitignore

# OS별
.DS_Store
Thumbs.db

# Go 빌드/캐시
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.a
*.o
*.obj
*.swp
*.swo
*.tmp
*.log
coverage.out

# Go 모듈 캐시
/pkg/
/go.sum

# Node.js/프론트엔드
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE/에디터
.vscode/
.idea/
*.code-workspace

# 환경/설정 파일
.env
.env.*

# 기타
*.local
*.bak
*.old

# Wails 빌드 산출물
apps/*/build/bin/

# macOS
.AppleDouble
.LSOverride

# 테스트 산출물
coverage/

# 패키지별 예외 필요시 아래에 추가
